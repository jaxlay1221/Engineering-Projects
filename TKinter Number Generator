import tkinter as tk
import numpy as np

GUI = tk.Tk()
label = tk.Label(GUI, text="Enter a random number between 1 and 100:")
label.pack()
GUI.config(bg="lavender")

random_number = np.random.randint(1, 100)

guess_entry = tk.Entry(GUI)
guess_entry.pack()

def submit_guess():
    try:
        guess = int(guess_entry.get())
    except ValueError:
        result_label.config(text="Please enter a whole number.")
        return

    if not 1 <= guess <= 100:
        result_label.config(text="Number must be between 1 and 100.")
        return

    result_label.config(
        text=f"You entered: {guess}. The correct number is: {random_number}."
    )


submit_button = tk.Button(GUI, text="Submit", command=submit_guess)
submit_button.pack()
submit_button.config(bg="black", fg="white")

result_label = tk.Label(GUI, text="")
result_label.pack()
GUI.mainloop()
